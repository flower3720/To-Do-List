<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TodoApi</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Swagger / OpenAPI 接口文档 -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />

    <!-- EF Core + SQLite 数据访问 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.31" />

    <!-- 设计时包：dotnet ef migrations / database update 需要 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- 对象映射：Entity <-> DTO -->
    <PackageReference Include="AutoMapper" Version="13.0.1" />
  </ItemGroup>

</Project>
